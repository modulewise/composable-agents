package composable:a2a@0.1.0;

/// Types for the A2A protocol that an agent's own interface doesn't need: the
/// agent card and what a response streams. The types that both share (such as
/// messages, tasks, artifacts and skills) are `composable:agents/types`.
interface types {
  use composable:agents/types@0.1.0.{json, message, task, task-status-update-event, task-artifact-update-event, agent-provider, agent-extension, agent-skill, security-requirement};

  /// One value the agent streams in its response: the task, an immediate
  /// response message, or an update related to a task (status or artifact).
  variant stream-response {
    task(task),
    message(message),
    status-update(task-status-update-event),
    artifact-update(task-artifact-update-event),
  }

  record api-key-security-scheme {
    description: option<string>,
    /// Location of the API key: "query", "header", or "cookie".
    location: string,
    /// Name of the header, query, or cookie parameter.
    name: string,
  }

  record http-auth-security-scheme {
    description: option<string>,
    /// HTTP auth scheme name per RFC 7235 (e.g. "Bearer", "Basic").
    scheme: string,
    /// Hint for how the bearer token is formatted (e.g. "JWT").
    bearer-format: option<string>,
  }

  record open-id-connect-security-scheme {
    description: option<string>,
    /// OpenID Connect discovery URL.
    open-id-connect-url: string,
  }

  record mutual-tls-security-scheme {
    description: option<string>,
  }

  record authorization-code-oauth-flow {
    authorization-url: string,
    token-url: string,
    refresh-url: option<string>,
    /// Available scopes: name as key, description as value.
    scopes: map<string, string>,
    /// Whether PKCE (RFC 7636) is required.
    pkce-required: bool,
  }

  record client-credentials-oauth-flow {
    token-url: string,
    refresh-url: option<string>,
    scopes: map<string, string>,
  }

  /// Deprecated by OAuth 2.1; included for completeness.
  record implicit-oauth-flow {
    authorization-url: option<string>,
    refresh-url: option<string>,
    scopes: map<string, string>,
  }

  /// Deprecated by OAuth 2.1; included for completeness.
  record password-oauth-flow {
    token-url: option<string>,
    refresh-url: option<string>,
    scopes: map<string, string>,
  }

  record device-code-oauth-flow {
    device-authorization-url: string,
    token-url: string,
    refresh-url: option<string>,
    scopes: map<string, string>,
  }

  /// The configured flow for an oauth2 scheme.
  variant oauth-flows {
    authorization-code(authorization-code-oauth-flow),
    client-credentials(client-credentials-oauth-flow),
    implicit(implicit-oauth-flow),
    password(password-oauth-flow),
    device-code(device-code-oauth-flow),
  }

  record oauth2-security-scheme {
    description: option<string>,
    flows: oauth-flows,
    /// URL to the OAuth2 authorization server metadata (RFC 8414).
    oauth2-metadata-url: option<string>,
  }

  /// How to authenticate to an agent (one of the supported scheme types).
  variant security-scheme {
    api-key-security-scheme(api-key-security-scheme),
    http-auth-security-scheme(http-auth-security-scheme),
    oauth2-security-scheme(oauth2-security-scheme),
    open-id-connect-security-scheme(open-id-connect-security-scheme),
    mtls-security-scheme(mutual-tls-security-scheme),
  }

  /// A JWS signature over an agent-card (RFC 7515).
  record agent-card-signature {
    /// Base64url-encoded protected JWS header.
    protected: string,
    /// Base64url-encoded signature.
    signature: string,
    /// Unprotected JWS header values.
    header: option<json>,
  }

  /// Agent endpoint with protocol details.
  record agent-interface {
    /// URL where this interface is available.
    url: string,
    /// Protocol binding (e.g. "JSONRPC", "GRPC", "HTTP+JSON").
    protocol-binding: string,
    /// Routing value, if the endpoint requires one.
    tenant: option<string>,
    /// A2A protocol version this interface exposes.
    protocol-version: string,
  }

  record agent-capabilities {
    streaming: option<bool>,
    push-notifications: option<bool>,
    extensions: list<agent-extension>,
    extended-agent-card: option<bool>,
  }

  /// A self-describing manifest for an agent.
  record agent-card {
    name: string,
    description: string,
    /// Supported interfaces (at least one); the first entry is preferred.
    supported-interfaces: list<agent-interface>,
    provider: option<agent-provider>,
    version: string,
    documentation-url: option<string>,
    capabilities: agent-capabilities,
    /// Security schemes the agent supports, by scheme name.
    security-schemes: map<string, security-scheme>,
    /// Security requirements for contacting the agent.
    security-requirements: list<security-requirement>,
    /// Default input media types for this agent (at least one).
    default-input-modes: list<string>,
    /// Default output media types for this agent (at least one).
    default-output-modes: list<string>,
    /// The agent's skills (at least one).
    skills: list<agent-skill>,
    /// JWS signatures computed over this agent-card.
    signatures: list<agent-card-signature>,
    icon-url: option<string>,
  }
}

/// A2A Client Interface. Calls an agent that an A2A server hosts.
interface client {
  use composable:agents/types@0.1.0.{json, message, task, task-state};
  use types.{agent-card, agent-interface, stream-response};

  /// A2A's `SendMessageConfiguration`, without
  /// `task-push-notification-config`.
  record send-message-configuration {
    /// The media types the client accepts for response parts.
    accepted-output-modes: list<string>,
    /// The most recent messages of the task's history to include, or
    /// `none` for no limit.
    history-length: option<u32>,
    /// Whether `send-message` returns as soon as the task is created,
    /// instead of waiting for a terminal or interrupted state. It has no
    /// effect on `send-streaming-message`.
    return-immediately: bool,
  }

  /// A2A's `SendMessageRequest`, without `tenant`, which is the selected
  /// interface's.
  record send-message-request {
    message: message,
    configuration: option<send-message-configuration>,
    metadata: option<json>,
  }

  /// A2A's `SendMessageResponse`.
  variant send-message-response {
    task(task),
    message(message),
  }

  /// A2A's `GetTaskRequest`, without `tenant`.
  record get-task-request {
    id: string,
    /// The most recent messages of the task's history to include, or
    /// `none` for no limit.
    history-length: option<u32>,
  }

  /// A2A's `CancelTaskRequest`, without `tenant`.
  record cancel-task-request {
    id: string,
    metadata: option<json>,
  }

  /// A2A's `ListTasksRequest`, without `tenant`.
  record list-tasks-request {
    /// Only the tasks of this context.
    context-id: option<string>,
    /// Only the tasks in this state.
    status: option<task-state>,
    /// The most tasks to return, from 1 to 100. The agent's default is 50.
    page-size: option<u32>,
    /// `next-page-token` from the previous page.
    page-token: option<string>,
    /// The most recent messages of each task's history to include.
    history-length: option<u32>,
    /// Only the tasks whose status changed at or after this ISO 8601
    /// timestamp.
    status-timestamp-after: option<string>,
    /// Whether to include each task's artifacts. The agent's default is
    /// false.
    include-artifacts: option<bool>,
  }

  /// A2A's `ListTasksResponse`.
  record list-tasks-response {
    tasks: list<task>,
    /// The token for the next page, or empty when there are no more.
    next-page-token: string,
    /// The page size used for this response.
    page-size: u32,
    /// The number of tasks available before paging.
    total-size: u32,
  }

  /// A failed request. A JSON-RPC error from the agent has its `code` and
  /// `data`. Any other failure, such as an unreachable agent, has only a
  /// `message`.
  record error {
    message: string,
    /// The JSON-RPC error code.
    code: option<s32>,
    /// The JSON-RPC error's data.
    data: option<json>,
  }

  /// What `send-streaming-message` returns.
  record message-response-stream {
    /// A task followed by its status and artifact updates until it reaches
    /// a terminal or interrupted state, or one message.
    responses: stream<stream-response>,
    /// Resolves when the responses end, with an error if the stream
    /// failed.
    %result: future<result<_, error>>,
  }

  /// An agent on an A2A server.
  resource agent {
    /// The agent's card, as fetched by `connect`.
    card: func() -> agent-card;
    /// The interface that requests are sent to.
    %interface: func() -> agent-interface;
    /// The extensions listed as activated in the agent's most recent
    /// response.
    activated-extensions: func() -> list<string>;
    /// A2A's `SendMessage`. Sends a message and returns the task that
    /// handles it, or a message in response. An agent that streams
    /// (`capabilities.streaming` on its card) also takes
    /// `send-streaming-message`, which is preferred.
    send-message: async func(request: send-message-request) -> result<send-message-response, error>;
    /// A2A's `SendStreamingMessage`. Sends a message and streams the
    /// agent's responses as they occur.
    send-streaming-message: async func(request: send-message-request) -> result<message-response-stream, error>;
    /// A2A's `GetTask`.
    get-task: async func(request: get-task-request) -> result<task, error>;
    /// A2A's `ListTasks`.
    list-tasks: async func(request: list-tasks-request) -> result<list-tasks-response, error>;
    /// A2A's `CancelTask`. Returns the task's updated state.
    cancel-task: async func(request: cancel-task-request) -> result<task, error>;
  }

  /// Fetches the agent's card from `server-url` and selects the first
  /// interface the client supports. Each request to the agent asks it to
  /// activate `extensions` (A2A's `A2A-Extensions`). Fails when the card has
  /// no interface the client supports, or requires an extension that isn't
  /// in `extensions`.
  connect: async func(server-url: string, extensions: list<string>) -> result<agent, error>;
}

