/// Model Client Interface. A common abstraction over language model APIs.
///
/// A `session` resource is created for one agent invocation, with the caller's
/// `model-settings` and any earlier exchanges from the conversation.

interface client {
    use types.{model-settings, model-request, model-exchange, model-call, model-error, session-error};

    /// An agent invocation.
    resource session {
        /// Create a session with the caller's settings, continuing from the
        /// conversation's earlier exchanges, oldest first. Fails on history
        /// the client cannot use, settings it cannot send, or invalid config.
        constructor(settings: model-settings, history: list<model-exchange>) -> result<session, session-error>;

        /// Make one model call and stream the model's response as a series of
        /// `model-delta` items followed by a final `model-response`. Fails,
        /// with nothing sent or recorded, when no client receives the call
        /// (e.g. an interceptor refuses it). The call's response is an error,
        /// with nothing sent or recorded, on input the client cannot send, or
        /// when the session's previous call's `result` has not resolved. A
        /// failure sending the request or reading the response resolves the
        /// stream's `result`.
        call: async func(request: model-request) -> result<model-call, model-error>;

        /// The exchanges this session's calls made, oldest first. A call's
        /// exchange is complete once the call's `result` resolves.
        exchanges: func() -> list<model-exchange>;
    }
}
