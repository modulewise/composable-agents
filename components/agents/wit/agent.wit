/// Agent Interface
///
/// An agent handles one request at a time as a task, delegating to a model.
/// Depending on the agent, it may also call tools and/or other agents.

interface agent {
    use types.{agent-metadata, agent-request, agent-response-stream, agent-error};

    /// Information about the agent, which may contribute to an A2A agent card.
    metadata: async func() -> result<agent-metadata, string>;

    /// Handle a request as a task. Stream the task's events, then its outcome.
    invoke: async func(request: agent-request) -> result<agent-response-stream, agent-error>;
}

/// An agent that delegates to a model. An agent component may include this
/// world in its own, along with anything else it imports.
world base-agent {
    import model-client;

    export agent;
}
